# Backblaze B2 (required) — S3-compatible API
B2_ENDPOINT=your_b2_endpoint
B2_REGION=your_b2_region
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Example of what filled-in values look like (fake — for visual reference only):
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001AbCdEfGhIjKlMnOpQrStUvWxYz0=
# B2_BUCKET_NAME=my-headshot-bucket

# --- Engines (optional; sensible $0 defaults) ---
# Training / generation engine: "local" (default — real SD-1.5 LoRA on your
# machine, $0, no keys) or "replicate" (real hosted FLUX, paid, needs token).
# TRAINER_PROVIDER=local
# GENERATOR_PROVIDER=local

# --- Optional external API keys (NOT B2 credentials) ---
# Replicate hosted FLUX path. Costs ~$3-5 per full run — never the default.
# Get one at https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=your_replicate_token

# Anthropic Claude vision for selfie auto-captioning (peripheral, < $0.10/run).
# Falls back to a templated caption when unset. https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_key
